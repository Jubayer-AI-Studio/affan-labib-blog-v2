---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorHero from '../components/AuthorHero.astro';
import SpotlightPost from '../components/SpotlightPost.astro';
import PostCard from '../components/PostCard.astro';
import QuoteBox from '../components/QuoteBox.astro';
import { getCollection } from 'astro:content';
import { toBengaliNumber, CATEGORY_MAP } from '../utils/helpers';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);

// Pinned / Spotlight Post (e.g. Takhasus or first post)
const spotlightPost = sortedPosts.find((p) => p.data.isPinned) || sortedPosts[0];
// Remaining posts for grid
const remainingPosts = sortedPosts.filter((p) => p.slug !== spotlightPost.slug);

const categories = Object.keys(CATEGORY_MAP) as (keyof typeof CATEGORY_MAP)[];
---

<BaseLayout>
  <!-- 1. Hollywood Author Hero Card with Instant Photo Change Option -->
  <AuthorHero />

  <!-- 2. Magazine Spotlight / Pinned Story -->
  <SpotlightPost post={spotlightPost} />

  <!-- 3. Interactive Category Filter & All Articles Stream -->
  <section class="mt-14 mb-16">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-1.5 text-xs font-sans font-semibold text-paper-accent dark:text-night-accent uppercase tracking-wider mb-1">
          <span>📑</span>
          <span>বিষয়ভিত্তিক পাঠাগার</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold font-serif text-paper-text dark:text-night-text tracking-tight">
          সকল পাঠ ও চিন্তা
        </h2>
      </div>

      <div class="text-xs font-sans text-paper-muted dark:text-night-muted">
        মোট <span id="visible-count" class="font-bold text-paper-accent dark:text-night-accent">{toBengaliNumber(remainingPosts.length)}</span> টি রচনা প্রদর্শিত হচ্ছে
      </div>
    </div>

    <!-- Live Category Filter Tabs (Zero Reload Smooth Filter) -->
    <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-8 no-scrollbar text-xs font-sans">
      <button
        type="button"
        class="category-tab px-4 py-2 rounded-full font-medium transition-all duration-200 cursor-pointer whitespace-nowrap bg-paper-accent text-white shadow-xs"
        data-filter="all"
      >
        <span>সব রচনা</span>
        <span class="ml-1 opacity-80">({toBengaliNumber(remainingPosts.length)})</span>
      </button>

      {categories.map((catKey) => {
        const cat = CATEGORY_MAP[catKey];
        const count = remainingPosts.filter((p) => p.data.category === catKey).length;
        return (
          <button
            type="button"
            class="category-tab px-4 py-2 rounded-full font-medium transition-all duration-200 cursor-pointer whitespace-nowrap border border-paper-border dark:border-night-border bg-paper-surface/60 dark:bg-night-surface/60 text-paper-muted dark:text-night-muted hover:border-paper-accent hover:text-paper-accent shadow-2xs"
            data-filter={catKey}
          >
            <span>{cat.label}</span>
            <span class="ml-1 text-[11px] opacity-75">({toBengaliNumber(count)})</span>
          </button>
        );
      })}
    </div>

    <!-- 2-Column Responsive Post Grid -->
    <div id="posts-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6 transition-opacity duration-300">
      {remainingPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>

    <!-- Empty Filter Notice (Hidden by default) -->
    <div id="empty-filter-notice" class="hidden py-16 text-center rounded-3xl border border-dashed border-paper-border dark:border-night-border bg-paper-surface/40 dark:bg-night-surface/40 max-w-md mx-auto my-6 space-y-3">
      <span class="text-4xl block">📜</span>
      <h3 class="text-lg font-bold font-serif text-paper-text dark:text-night-text">
        এই বিষয়ে লেখা প্রস্তুত হচ্ছে...
      </h3>
      <p class="text-xs font-serif text-paper-muted dark:text-night-muted leading-relaxed px-4">
        খুব শীঘ্রই এই বিভাগে নতুন গবেষণা ও অনুবাদমূলক রচনা প্রকাশিত হবে।
      </p>
    </div>
  </section>

  <!-- 4. Featured Literary Quote Box -->
  <QuoteBox />
</BaseLayout>

<script is:inline>
  const tabs = document.querySelectorAll('.category-tab');
  const postItems = document.querySelectorAll('.post-item');
  const emptyNotice = document.getElementById('empty-filter-notice');
  const visibleCount = document.getElementById('visible-count');

  function toBnNum(num) {
    const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
    return num.toString().replace(/[0-9]/g, (d) => bnDigits[parseInt(d, 10)]);
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const filter = tab.getAttribute('data-filter');

      // Update active tab styles
      tabs.forEach((t) => {
        t.classList.remove('bg-paper-accent', 'text-white', 'shadow-xs');
        t.classList.add(
          'border',
          'border-paper-border',
          'dark:border-night-border',
          'bg-paper-surface/60',
          'dark:bg-night-surface/60',
          'text-paper-muted',
          'dark:text-night-muted'
        );
      });

      tab.classList.remove(
        'border',
        'border-paper-border',
        'dark:border-night-border',
        'bg-paper-surface/60',
        'dark:bg-night-surface/60',
        'text-paper-muted',
        'dark:text-night-muted'
      );
      tab.classList.add('bg-paper-accent', 'text-white', 'shadow-xs');

      // Silky smooth transition
      const grid = document.getElementById('posts-grid');
      if (grid) {
        grid.classList.add('opacity-40', 'scale-[0.99]');
      }

      setTimeout(() => {
        // Filter post cards
        let visible = 0;
        postItems.forEach((item) => {
          const itemCat = item.getAttribute('data-category');
          if (filter === 'all' || itemCat === filter) {
            item.classList.remove('hidden');
            visible++;
          } else {
            item.classList.add('hidden');
          }
        });

        if (visibleCount) {
          visibleCount.innerText = toBnNum(visible);
        }

        if (emptyNotice) {
          if (visible === 0) {
            emptyNotice.classList.remove('hidden');
          } else {
            emptyNotice.classList.add('hidden');
          }
        }

        if (grid) {
          grid.classList.remove('opacity-40', 'scale-[0.99]');
        }
      }, 120);
    });
  });
</script>
