---
// src/pages/search.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatBengaliDate, toBengaliNumber, CATEGORY_MAP } from '../utils/helpers';

const allPosts = await getCollection('posts');
const searchablePosts = allPosts.map((post) => {
  // Strip markdown symbols to create clean plain body text for search
  const cleanBody = (post.body || '')
    .replace(/[#*`_~>[\]()]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  return {
    title: post.data.title,
    slug: post.slug,
    description: post.data.description,
    category: post.data.category,
    categoryLabel: CATEGORY_MAP[post.data.category]?.label || post.data.category,
    tags: post.data.tags,
    publishedAt: post.data.publishedAt,
    formattedDate: formatBengaliDate(post.data.publishedAt),
    body: cleanBody,
  };
});
---

<BaseLayout
  title="অনুসন্ধান | আফফান লাবীব"
  description="আফফান লাবীবের ব্লগ থেকে যেকোনো লেখা বা বিষয় অনুসন্ধান করুন।"
>
  <div class="max-w-2xl mx-auto space-y-8 font-serif rounded-3xl border border-paper-border/70 dark:border-night-border/70 bg-paper-surface/85 dark:bg-night-surface/85 backdrop-blur-xl p-6 sm:p-10 shadow-sm">
    <!-- Header -->
    <header class="space-y-2 border-b border-paper-border/80 dark:border-night-border/80 pb-6">
      <h1 class="text-3xl font-bold text-paper-text dark:text-night-text">
        অনুসন্ধান
      </h1>
      <p class="text-sm text-paper-muted dark:text-night-muted">
        শিরোনাম, বিষয়শ্রেণী, ট্যাগ কিংবা লেখার ভেতরের যেকোনো বাক্য বা উক্তি দিয়ে অনুসন্ধান করুন।
      </p>

      <!-- Search Input Box -->
      <div class="pt-4">
        <div class="relative">
          <input
            id="search-input"
            type="search"
            placeholder="কী পড়তে চান লিখুন... (যেমন: পরীক্ষা, কাফেলা, ইবনে বতুতা, বই)"
            autofocus
            class="w-full px-4 py-3 pl-11 rounded-lg border border-paper-border dark:border-night-border bg-paper-surface dark:bg-night-surface text-paper-text dark:text-night-text focus:outline-none focus:border-paper-accent dark:focus:border-night-accent font-serif text-base shadow-2xs transition-colors"
          />
          <svg class="w-5 h-5 text-paper-muted dark:text-night-muted absolute left-3.5 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
    </header>

    <!-- Search Stats & Results Container -->
    <div id="results-count" class="text-xs font-sans text-paper-muted dark:text-night-muted">
      মোট {toBengaliNumber(searchablePosts.length)} টি লেখা থেকে খুঁজছেন...
    </div>

    <div id="results-container" class="divide-y divide-paper-border/60 dark:divide-night-border/60">
      <!-- Search items rendered dynamically by JavaScript -->
    </div>
  </div>

  <script define:vars={{ searchablePosts }}>
    const input = document.getElementById('search-input');
    const container = document.getElementById('results-container');
    const countEl = document.getElementById('results-count');

    // Bengali numerals conversion helper in client JS
    function toBnNum(n) {
      const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
      return n.toString().replace(/[0-9]/g, (d) => bnDigits[parseInt(d, 10)]);
    }

    function highlightText(text, query) {
      if (!query) return text;
      const regex = new RegExp(`(${query})`, 'gi');
      return text.replace(regex, '<mark class="bg-amber-200 dark:bg-amber-900/60 text-inherit px-0.5 rounded">$1</mark>');
    }

    function extractSnippet(body, query) {
      if (!query || !body) return '';
      const lowerBody = body.toLowerCase();
      const idx = lowerBody.indexOf(query.toLowerCase());
      if (idx === -1) return '';

      const start = Math.max(0, idx - 60);
      const end = Math.min(body.length, idx + query.length + 80);
      let snippet = body.substring(start, end);
      if (start > 0) snippet = '...' + snippet;
      if (end < body.length) snippet = snippet + '...';

      return highlightText(snippet, query);
    }

    function renderResults(posts, query) {
      if (!container) return;
      container.innerHTML = '';

      if (posts.length === 0) {
        container.innerHTML = `
          <div class="py-12 text-center text-paper-muted dark:text-night-muted font-serif space-y-2">
            <p>'${query}' সংক্রান্ত কোনো লেখা খুঁজে পাওয়া যায়নি।</p>
            <p class="text-xs font-sans">বানান সঠিক আছে কিনা দেখুন বা অন্য কোনো শব্দ লিখে অনুসন্ধান করুন।</p>
          </div>
        `;
        if (countEl) countEl.innerText = '০ টি ফলাফল পাওয়া গেছে';
        return;
      }

      if (countEl) {
        countEl.innerText = query
          ? `${toBnNum(posts.length)} টি ফলাফল পাওয়া গেছে`
          : `মোট ${toBnNum(posts.length)} টি লেখা প্রদর্শিত হচ্ছে`;
      }

      posts.forEach((post) => {
        const article = document.createElement('article');
        article.className = 'py-6 group transition-colors';

        const snippet = query ? extractSnippet(post.body, query) : '';
        const highlightedTitle = query ? highlightText(post.title, query) : post.title;
        const highlightedDesc = query ? highlightText(post.description, query) : post.description;

        article.innerHTML = `
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-xs font-sans text-paper-muted dark:text-night-muted">
              <span class="font-semibold text-paper-accent dark:text-night-accent font-serif">${post.categoryLabel}</span>
              <span>·</span>
              <time>${post.formattedDate}</time>
            </div>
            <h2 class="text-xl font-bold font-serif text-paper-text dark:text-night-text group-hover:text-paper-accent dark:group-hover:text-night-accent transition-colors leading-snug">
              <a href="/${post.slug}">
                ${highlightedTitle}
              </a>
            </h2>
            <p class="text-sm text-paper-muted dark:text-night-muted font-serif line-clamp-2">
              ${highlightedDesc}
            </p>
            ${
              snippet
                ? `<div class="mt-2 text-xs font-serif text-paper-text/80 dark:text-night-text/80 bg-paper-border/20 dark:bg-night-border/30 p-2.5 rounded-md border-l-2 border-paper-accent/60 dark:border-night-accent/60">
                    <span class="text-[10px] uppercase font-sans text-paper-accent dark:text-night-accent block mb-0.5">লেখার ভেতর থেকে উক্তি:</span>
                    ${snippet}
                  </div>`
                : ''
            }
          </div>
        `;
        container.appendChild(article);
      });
    }

    // Initial render
    renderResults(searchablePosts, '');

    // Event listener for live search
    input?.addEventListener('input', (e) => {
      const q = e.target.value.trim().toLowerCase();
      if (!q) {
        renderResults(searchablePosts, '');
        return;
      }

      const filtered = searchablePosts.filter((post) => {
        const titleMatch = post.title.toLowerCase().includes(q);
        const descMatch = post.description.toLowerCase().includes(q);
        const catMatch = post.categoryLabel.toLowerCase().includes(q);
        const tagMatch = post.tags.some((t) => t.toLowerCase().includes(q));
        const bodyMatch = post.body.toLowerCase().includes(q);
        return titleMatch || descMatch || catMatch || tagMatch || bodyMatch;
      });

      renderResults(filtered, q);
    });
  </script>
</BaseLayout>
