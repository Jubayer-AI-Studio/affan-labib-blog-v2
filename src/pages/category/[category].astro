---
// src/pages/category/[category].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { formatBengaliDate, calculateReadingTime, toBengaliNumber, CATEGORY_MAP } from '../../utils/helpers';

export async function getStaticPaths() {
  const categories = Object.keys(CATEGORY_MAP);
  return categories.map((catKey) => ({
    params: { category: catKey },
    props: {
      categoryInfo: CATEGORY_MAP[catKey],
      catKey,
    },
  }));
}

const { categoryInfo, catKey } = Astro.props;

const allPosts = await getCollection('posts');
const categoryPosts = allPosts
  .filter((post) => post.data.category === catKey)
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());
---

<BaseLayout
  title={`${categoryInfo.label} | আফফান লাবীব`}
  description={categoryInfo.desc}
>
  <div class="max-w-4xl mx-auto space-y-10">
    <!-- Category Header -->
    <header class="border-b border-paper-border/80 dark:border-night-border/80 pb-8 space-y-2">
      <div class="text-xs font-sans text-paper-accent dark:text-night-accent font-semibold tracking-wider">
        বিষয়শ্রেণী
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold font-serif text-paper-text dark:text-night-text">
        {categoryInfo.label}
      </h1>
      <p class="text-base sm:text-lg text-paper-muted dark:text-night-muted font-serif">
        {categoryInfo.desc}
      </p>
      <div class="text-xs font-sans text-paper-muted dark:text-night-muted pt-2">
        {categoryPosts.length === 0 && catKey === 'onubad' ? (
          <span class="text-paper-accent dark:text-night-accent font-medium">শীঘ্রই লেখা প্রকাশিত হবে</span>
        ) : (
          <span>এই বিভাগে মোট {toBengaliNumber(categoryPosts.length)} টি লেখা রয়েছে।</span>
        )}
      </div>
    </header>

    <!-- Post Grid -->
    {categoryPosts.length === 0 ? (
      catKey === 'onubad' ? (
        <div class="py-14 text-center max-w-lg mx-auto space-y-4">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-paper-accent/10 dark:bg-night-accent/10 text-paper-accent dark:text-night-accent flex items-center justify-center border border-paper-accent/20 dark:border-night-accent/20">
            <span class="text-2xl">📜</span>
          </div>
          <h3 class="text-xl font-bold font-serif text-paper-text dark:text-night-text">
            অনুবাদ সংকলন প্রস্তুত হচ্ছে...
          </h3>
          <p class="text-sm font-serif text-paper-muted dark:text-night-muted leading-relaxed">
            আরবি, ইংরেজি ও অন্যান্য ভাষার ধ্রুপদী চিন্তামূলক রচনার সাহিত্যিক ও মননশীল রূপান্তর খুব শীঘ্রই এই ঘরে প্রকাশ করা হবে। সঙ্গেই থাকুন।
          </p>
          <div class="pt-2">
            <a
              href="/"
              class="inline-flex items-center gap-1 text-xs font-sans text-paper-accent dark:text-night-accent hover:underline font-semibold"
            >
              ← অন্যান্য বিভাগের লেখাগুলো পড়ুন
            </a>
          </div>
        </div>
      ) : (
        <p class="py-12 text-center text-paper-muted dark:text-night-muted font-serif">
          এই বিভাগে এখনো কোনো লেখা প্রকাশিত হয়নি।
        </p>
      )
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {categoryPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )}

    <!-- Back to home -->
    <div class="pt-6">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-sm font-sans font-medium text-paper-muted dark:text-night-muted hover:text-paper-accent dark:hover:text-night-accent transition-colors"
      >
        <span>← প্রথম পাতায় ফিরে যান</span>
      </a>
    </div>
  </div>
</BaseLayout>
