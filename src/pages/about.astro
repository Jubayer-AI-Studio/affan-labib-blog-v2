---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import author from '../data/author.json';
---

<BaseLayout
  title={`আমার সম্পর্কে | ${author.name}`}
  description={`${author.name} - ${author.tagline}। সংক্ষিপ্ত পরিচয়, চিন্তা ও এই পাঠশালার প্রেক্ষাপট।`}
>
  <div class="max-w-2xl mx-auto font-serif space-y-10 rounded-3xl border border-paper-border/70 dark:border-night-border/70 bg-paper-surface/85 dark:bg-night-surface/85 backdrop-blur-xl p-6 sm:p-10 shadow-sm">
    <!-- Header with Author Portrait -->
    <header class="border-b border-paper-border/80 dark:border-night-border/80 pb-8 flex flex-col sm:flex-row items-center sm:items-start gap-6">
      <img
        src={author.avatar}
        alt={author.name}
        class="author-avatar-img w-28 h-28 sm:w-32 sm:h-32 rounded-2xl object-cover border-2 border-paper-accent/30 dark:border-night-accent/30 shadow-md flex-shrink-0"
      />
      <div class="space-y-2 text-center sm:text-left flex-grow">
        <div class="text-xs font-sans text-paper-accent dark:text-night-accent font-semibold tracking-wider uppercase">
          পরিচিতি ও পটভূমি
        </div>
        <h1 class="author-name-text text-3xl sm:text-4xl font-bold text-paper-text dark:text-night-text leading-tight">
          {author.name}
        </h1>
        <p class="author-edu-text text-base text-paper-accent dark:text-night-accent font-medium font-serif">
          {author.education}
        </p>
        <p class="author-tagline-text text-sm text-paper-muted dark:text-night-muted font-sans">
          {author.tagline}
        </p>
      </div>
    </header>

    <!-- Body Story -->
    <div class="prose prose-lg dark:prose-invert text-paper-text dark:text-night-text leading-relaxed space-y-6">
      <p class="author-biofull-text">
        {author.bioFull}
      </p>

      <h2 class="author-manifesto-title-text text-2xl font-bold font-serif text-paper-text dark:text-night-text mt-8 mb-4">
        {author.aboutManifestoTitle || "কেন এই পড়ার ঘর?"}
      </h2>
      <p class="author-manifesto-text">
        {author.aboutManifesto || "এই ওয়েবসাইটটি কোনো বাণিজ্যিক পোর্টাল বা একাডেমিক গবেষণাপত্র প্রকাশের জায়গা নয়। এটি আমার ব্যক্তিগত খাতা। পড়তে পড়তে যেসব প্রশ্ন আমাকে তাড়া করে ফেরে, ইতিহাসের যেসব বাঁক দেখে আমি থমকে দাঁড়াই, কিংবা কোনো বই পড়ে মনে যে মুগ্ধতা বা সংশয় তৈরি হয়—সেগুলোই আমি এখানে সরল ভাষায় নথিভুক্ত করি।"}
      </p>

      <div class="my-8 p-6 rounded-lg bg-paper-border/20 dark:bg-night-border/30 border-l-4 border-paper-accent dark:border-night-accent space-y-3 not-prose font-serif">
        <h3 class="font-bold text-lg text-paper-text dark:text-night-text">
          এখানে মূলত যা পাবেন:
        </h3>
        <ul class="space-y-2 text-sm sm:text-base text-paper-muted dark:text-night-muted list-disc list-inside">
          <li><strong>চিন্তা:</strong> জীবনের সাধারণ বিষয় নিয়ে ব্যক্তিগত আত্মানুসন্ধান ও মনন।</li>
          <li><strong>পাঠালাপ:</strong> বইয়ের ভেতর দিয়ে লেখক ও পাঠকের নীরব আলাপচারিতা।</li>
          <li><strong>ইতিহাস:</strong> অতীত জনপদ, মনীষী ও ইতিহাসের অজানা অধ্যায়।</li>
          <li><strong>বই-আলোচনা:</strong> সমকালীন ও চিরায়ত বইয়ের মননশীল মূল্যায়ন।</li>
          <li><strong>অনুবাদ:</strong> আরবি, ইংরেজি বা অন্যান্য ভাষার চিন্তাশীল রচনার মার্জিত রূপান্তর।</li>
        </ul>
      </div>

      <h2 class="text-2xl font-bold font-serif text-paper-text dark:text-night-text mt-8 mb-4">
        সরাসরি যোগাযোগ
      </h2>
      <p>
        যেকোনো লেখার ব্যাপারে আপনার নিজস্ব মতামত, কোনো প্রশ্ন বা আলোচনার আগ্রহ থাকলে সরাসরি যুক্ত হতে পারেন। আপনার যেকোনো পাঠ-প্রতিক্রিয়া আমার কাছে পরম আনন্দের।
      </p>
    </div>

    <!-- Active Social & Contact Hub -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 not-prose font-sans text-sm">
      <!-- Facebook Profile Card -->
      <a
        href={author.social.facebook}
        target="_blank"
        rel="noopener noreferrer"
        class="author-facebook-link p-4 rounded-xl border border-paper-border dark:border-night-border bg-paper-surface dark:bg-night-surface hover:border-blue-600 hover:shadow-xs transition-all flex items-center gap-3.5 group"
      >
        <div class="w-10 h-10 rounded-lg bg-blue-50 dark:bg-blue-950/40 text-blue-600 flex items-center justify-center font-bold text-lg group-hover:scale-105 transition-transform">
          f
        </div>
        <div>
          <div class="text-xs text-paper-muted dark:text-night-muted">ফেসবুক প্রোফাইল</div>
          <div class="font-semibold text-paper-text dark:text-night-text group-hover:text-blue-600 transition-colors">
            ফেসবুকে যুক্ত হন ↗
          </div>
        </div>
      </a>

      <!-- WhatsApp Direct Card -->
      <a
        href={author.social.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="author-whatsapp-link p-4 rounded-xl border border-paper-border dark:border-night-border bg-paper-surface dark:bg-night-surface hover:border-emerald-600 hover:shadow-xs transition-all flex items-center gap-3.5 group"
      >
        <div class="w-10 h-10 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 flex items-center justify-center group-hover:scale-105 transition-transform">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z" />
          </svg>
        </div>
        <div>
          <div class="text-xs text-paper-muted dark:text-night-muted">হোয়াটসঅ্যাপ বার্তা</div>
          <div class="font-semibold text-paper-text dark:text-night-text group-hover:text-emerald-600 transition-colors">
            {author.social.whatsappNumber} ↗
          </div>
        </div>
      </a>
    </div>
  </div>
</BaseLayout>
