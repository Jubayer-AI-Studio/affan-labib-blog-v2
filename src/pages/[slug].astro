---
// src/pages/[slug].astro
import BaseLayout from '../layouts/BaseLayout.astro';
import BookInfoCard from '../components/BookInfoCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatBengaliDate, calculateReadingTime, CATEGORY_MAP } from '../utils/helpers';
import author from '../data/author.json';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const catInfo = CATEGORY_MAP[post.data.category] || { label: post.data.category, slug: post.data.category };
const formattedDate = formatBengaliDate(post.data.publishedAt);
const readingTime = calculateReadingTime(post.body || '');
---

<BaseLayout
  title={`${post.data.title} | আফফান লাবীব`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.publishedAt}
>
  <!-- Sticky Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-paper-accent dark:bg-night-accent z-50 w-0 transition-all duration-75"></div>

  <article class="max-w-2xl mx-auto font-serif rounded-3xl border border-paper-border/70 dark:border-night-border/70 bg-paper-surface/85 dark:bg-night-surface/85 backdrop-blur-xl p-6 sm:p-10 shadow-sm">
    <!-- Header -->
    <header class="mb-10 space-y-5">
      <div class="flex items-center gap-2 text-xs font-sans text-paper-muted dark:text-night-muted flex-wrap">
        <a
          href={`/category/${catInfo.slug}`}
          class="font-semibold text-paper-accent dark:text-night-accent hover:underline font-serif text-sm"
        >
          {catInfo.label}
        </a>
        <span>·</span>
        <time datetime={post.data.publishedAt}>{formattedDate}</time>
        <span>·</span>
        <span>{readingTime}</span>
        {post.data.originalAuthor && (
          <>
            <span>·</span>
            <span class="text-paper-text/80 dark:text-night-text/80">মূল লেখক: {post.data.originalAuthor}</span>
          </>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-paper-text dark:text-night-text font-serif leading-tight">
        {post.data.title}
      </h1>

      <!-- Author Byline Bar -->
      <div class="flex items-center gap-3 pt-2 pb-1 border-b border-paper-border/50 dark:border-night-border/50">
        <img
          src={author.avatar}
          alt={author.name}
          class="author-avatar-img w-10 h-10 rounded-full object-cover ring-2 ring-paper-accent/20"
        />
        <div class="text-xs font-sans">
          <span class="font-semibold text-paper-text dark:text-night-text block">{author.name}</span>
          <span class="text-paper-muted dark:text-night-muted">{author.tagline}</span>
        </div>
      </div>

      {post.data.previouslyPublished && (
        <div class="inline-flex items-center gap-1.5 text-xs font-sans text-paper-muted dark:text-night-muted bg-paper-border/30 dark:bg-night-border/40 px-2.5 py-1 rounded">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <span>পূর্বে প্রকাশিত: {post.data.previouslyPublished}</span>
        </div>
      )}

      <p class="text-lg text-paper-muted dark:text-night-muted leading-relaxed font-serif italic border-l-2 border-paper-accent/40 dark:border-night-accent/40 pl-4 py-1">
        {post.data.description}
      </p>

      <!-- Tags -->
      <div class="flex flex-wrap gap-2 pt-1">
        {post.data.tags.map((tag) => (
          <span class="text-xs font-sans px-2.5 py-1 rounded-md bg-paper-border/30 dark:bg-night-border/40 text-paper-muted dark:text-night-muted">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <!-- Book Review Metadata InfoCard (if category is book review) -->
    {post.data.bookInfo && (
      <BookInfoCard {...post.data.bookInfo} />
    )}

    <!-- Main Article Body -->
    <div class="prose prose-lg dark:prose-invert max-w-none text-paper-text dark:text-night-text leading-relaxed">
      <Content />
    </div>

    <!-- Footnotes Reference Section (if exists) -->
    {post.data.footnotes && post.data.footnotes.length > 0 && (
      <section class="mt-14 pt-8 border-t border-paper-border/80 dark:border-night-border/80 text-sm">
        <h3 class="font-sans font-bold text-xs uppercase tracking-wider text-paper-accent dark:text-night-accent mb-4 flex items-center gap-2">
          <span>📚</span> <span>তথ্যসূত্র ও টীকা (Footnotes & References)</span>
        </h3>
        <ol class="space-y-3 list-decimal list-inside text-paper-muted dark:text-night-muted">
          {post.data.footnotes.map((fn) => (
            <li id={`fn-${fn.id}`} class="leading-relaxed p-2.5 rounded-xl bg-paper-surface/50 dark:bg-night-surface/50 border border-paper-border/40 dark:border-night-border/40">
              <span class="text-paper-text dark:text-night-text font-serif">{fn.text}</span>
              <a href={`#fnref-${fn.id}`} class="inline-block ml-2 text-paper-accent dark:text-night-accent text-xs font-sans hover:underline" title="লেখায় ফিরে যান">
                ↩ ফিরে যান
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Social Share Bar & Actions -->
    <div class="mt-14 pt-8 border-t border-paper-border/70 dark:border-night-border/70 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="text-xs font-sans font-medium text-paper-muted dark:text-night-muted flex items-center gap-2">
        <span>লেখাটি ভালো লাগলে শেয়ার করতে পারেন:</span>
      </div>

      <div class="flex items-center gap-2 text-xs font-sans">
        <!-- Facebook Share -->
        <a
          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3.5 py-1.5 rounded-lg bg-[#1877F2] text-white font-semibold hover:bg-[#166fe5] shadow-2xs hover:scale-105 active:scale-95 transition-all flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          <span>Facebook শেয়ার</span>
        </a>
        <!-- WhatsApp Share -->
        <a
          href={`https://api.whatsapp.com/send?text=${encodeURIComponent(post.data.title + ' ' + Astro.url.href)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-3.5 py-1.5 rounded-lg bg-[#25D366] text-white font-semibold hover:bg-[#20ba59] shadow-2xs hover:scale-105 active:scale-95 transition-all flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>WhatsApp শেয়ার</span>
        </a>
        <!-- Copy Link Button -->
        <button
          id="copy-link-btn"
          type="button"
          class="px-3 py-1.5 rounded border border-paper-border dark:border-night-border hover:border-paper-accent dark:hover:border-night-accent hover:text-paper-accent dark:hover:text-night-accent transition-colors cursor-pointer"
        >
          লিংক কপি
        </button>

        <!-- Save / Print Button -->
        <button
          onclick="window.print()"
          type="button"
          class="px-3 py-1.5 rounded border border-paper-border dark:border-night-border hover:border-paper-accent dark:hover:border-night-accent hover:text-paper-accent dark:hover:text-night-accent transition-colors flex items-center gap-1 cursor-pointer"
          title="অফলাইনে সেভ বা প্রিন্ট করুন"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          সেভ / প্রিন্ট
        </button>
      </div>
    </div>

    <!-- Offline Saved Badge -->
    <div class="mt-4 flex items-center justify-center gap-2 text-xs font-sans text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/40 py-1.5 px-3 rounded-md">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
      <span>লেখাটি আপনার ডিভাইসে অফলাইনে সংরক্ষিত রয়েছে। ইন্টারনেট সংযোগ ছাড়াও পড়তে পারবেন।</span>
    </div>

    <!-- Back to Home Button -->
    <div class="mt-10 text-center">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-sm font-sans font-medium text-paper-muted dark:text-night-muted hover:text-paper-accent dark:hover:text-night-accent transition-colors"
      >
        <span>← সব লেখায় ফিরে যান</span>
      </a>
    </div>
  </article>

  <!-- Interactive In-Situ Footnote Popover / Bottom Sheet Modal -->
  <div
    id="footnote-popover-modal"
    class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/85 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-200"
    role="dialog"
    aria-modal="true"
    aria-labelledby="fn-popover-title"
  >
    <!-- Modal Card: 100% Opaque High-Contrast Luxury Slate/Gold Plaque -->
    <div
      id="footnote-popover-card"
      class="w-full max-w-lg bg-[#0F172A] border-t-2 sm:border-2 border-amber-500 rounded-t-3xl sm:rounded-3xl shadow-[0_25px_60px_-15px_rgba(0,0,0,0.9)] p-5 sm:p-6 font-serif relative transform translate-y-8 sm:translate-y-4 transition-transform duration-200 text-slate-100"
    >
      <!-- Mobile Pull handle indicator -->
      <div class="sm:hidden w-12 h-1.5 bg-amber-500/40 rounded-full mx-auto mb-3.5"></div>

      <!-- Header -->
      <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/20 border border-amber-500/50 text-amber-300 font-sans font-bold text-xs">
            <span>📚</span>
            <span id="fn-popover-title">তথ্যসূত্র ও বিশেষ টীকা</span>
            <span id="fn-popover-num" class="font-mono text-amber-200 text-sm"></span>
          </span>
        </div>
        <button
          id="close-fn-popover-btn"
          type="button"
          class="w-8 h-8 rounded-full bg-slate-800 hover:bg-slate-700 text-amber-400 hover:text-white border border-slate-700 flex items-center justify-center text-sm font-sans cursor-pointer transition-colors"
          title="বন্ধ করুন (Esc)"
        >
          ✕
        </button>
      </div>

      <!-- Footnote Text Body (High-Contrast Inset Reading Container) -->
      <div class="my-4 p-4 sm:p-5 rounded-2xl bg-[#1E293B] border border-slate-700/90 shadow-inner">
        <p id="fn-popover-content" class="text-base sm:text-lg text-slate-50 font-serif leading-relaxed">
          <!-- Text dynamically loaded here -->
        </p>
      </div>

      <!-- Action Bar -->
      <div class="pt-2 flex items-center justify-between border-t border-slate-800 font-sans text-xs">
        <span class="text-[11px] text-slate-400 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span>পপআপ বন্ধ করতে বাইরে ট্যাপ করুন</span>
        </span>
        <button
          id="done-fn-popover-btn"
          type="button"
          class="px-5 py-2 rounded-xl bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 text-white font-bold text-xs shadow-lg active:scale-95 transition-all cursor-pointer"
        >
          ✓ পড়া শেষ (বন্ধ করুন)
        </button>
      </div>
    </div>
  </div>

  <!-- Serialized Footnotes Data for in-situ popover -->
  {post.data.footnotes && (
    <script id="article-footnotes-data" type="application/json" set:html={JSON.stringify(post.data.footnotes)} />
  )}

  <script is:inline>
    // Reading Progress Bar
    window.addEventListener('scroll', () => {
      const progressBar = document.getElementById('reading-progress');
      if (!progressBar) return;
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      progressBar.style.width = scrolled + '%';
    }, { passive: true });

    // Global Avatar sync if saved in localStorage
    const savedAvatar = localStorage.getItem('kherokhata_author_avatar');
    if (savedAvatar) {
      document.querySelectorAll('.author-avatar-img').forEach((img) => {
        img.src = savedAvatar;
      });
    }

    const copyBtn = document.getElementById('copy-link-btn');
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const originalText = copyBtn.innerText;
        copyBtn.innerText = 'কপি হয়েছে!';
        setTimeout(() => {
          copyBtn.innerText = originalText;
        }, 2000);
      } catch (err) {
        console.error('Failed to copy: ', err);
      }
    });

    // In-Situ Footnote Popover Logic
    const fnModal = document.getElementById('footnote-popover-modal');
    const fnCard = document.getElementById('footnote-popover-card');
    const fnNum = document.getElementById('fn-popover-num');
    const fnContent = document.getElementById('fn-popover-content');
    const closeFnBtn = document.getElementById('close-fn-popover-btn');
    const doneFnBtn = document.getElementById('done-fn-popover-btn');

    let footnotesMap = {};
    const fnDataEl = document.getElementById('article-footnotes-data');
    if (fnDataEl) {
      try {
        const raw = JSON.parse(fnDataEl.textContent);
        raw.forEach(function(item) {
          footnotesMap[item.id] = item.text;
        });
      } catch (e) {}
    }

    function openFootnote(id, fallbackText) {
      if (!fnModal || !fnCard) return;
      const text = footnotesMap[id] || fallbackText || 'কোনো টীকা পাওয়া যায়নি।';
      if (fnNum) fnNum.textContent = `[${id}]`;
      if (fnContent) fnContent.textContent = text;

      fnModal.classList.remove('opacity-0', 'pointer-events-none');
      fnModal.classList.add('opacity-100', 'pointer-events-auto');
      fnCard.classList.remove('translate-y-8', 'sm:translate-y-4');
      fnCard.classList.add('translate-y-0');
    }

    function closeFootnote() {
      if (!fnModal || !fnCard) return;
      fnModal.classList.add('opacity-0', 'pointer-events-none');
      fnModal.classList.remove('opacity-100', 'pointer-events-auto');
      fnCard.classList.add('translate-y-8', 'sm:translate-y-4');
      fnCard.classList.remove('translate-y-0');
    }

    closeFnBtn?.addEventListener('click', closeFootnote);
    doneFnBtn?.addEventListener('click', closeFootnote);

    // Close on clicking backdrop
    fnModal?.addEventListener('click', (e) => {
      if (e.target === fnModal) {
        closeFootnote();
      }
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && fnModal && !fnModal.classList.contains('pointer-events-none')) {
        closeFootnote();
      }
    });

    // Intercept footnote clicks in article
    document.querySelectorAll('a[href^="#fn-"], sup[id^="fnref-"] a').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const href = link.getAttribute('href') || '';
        const idMatch = href.match(/#fn-(\d+)/);
        const fnId = idMatch ? idMatch[1] : link.textContent.replace(/[^\d]/g, '');

        let fallbackText = '';
        const targetLi = document.getElementById(`fn-${fnId}`);
        if (targetLi) {
          const span = targetLi.querySelector('.font-serif');
          fallbackText = span ? span.textContent : targetLi.textContent;
        }

        openFootnote(fnId, fallbackText);
      });
    });
  </script>
</BaseLayout>
