---
// BaseLayout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaterBackground from '../components/WaterBackground.astro';
import AdminBarModal from '../components/AdminBarModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title = 'আফফান লাবীব | চিন্তা ও পাঠের নিভৃত আঙিনা',
  description = 'সরল চিন্তা, পাঠের আনন্দ, ইতিহাসচর্চা ও বই-আলোচনার ব্যক্তিগত ঘর।',
  image = '/images/og-default.jpg',
  type = 'website',
  publishedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://affan-labib-blog.vercel.app');
---

<!doctype html>
<html lang="bn" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Fonts: High-Performance Non-Blocking Asynchronous Font Loading (Instant First Paint) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Amiri:ital,wght@0,400;0,700;1,400&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Amiri:ital,wght@0,400;0,700;1,400&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Amiri:ital,wght@0,400;0,700;1,400&display=swap"
      />
    </noscript>

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="আফফান লাবীব" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="আফফান লাবীব - RSS Feed" href="/rss.xml" />

    <!-- PWA Manifest & Mobile Configuration -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#9A3412" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="খেরোখাতা" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />


    <!-- Anti-flicker 3-Mode Theme Script (Light, Sepia, Dark) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      document.documentElement.classList.remove('dark', 'sepia');
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else if (theme === 'sepia') {
        document.documentElement.classList.add('sepia');
      }

      try {
        const savedLang = localStorage.getItem('kherokhata_lang');
        if (savedLang) {
          document.documentElement.lang = savedLang;
        }
      } catch (e) {}
    </script>
  </head>
  <body id="top" class="bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text min-h-screen flex flex-col font-sans selection:bg-orange-200 dark:selection:bg-orange-950 relative">
    <!-- Liquid Ambient Water Ripple Background -->
    <WaterBackground />

    <!-- Header -->
    <Header />

    <!-- Main Content Container -->
    <main class="flex-grow max-w-5xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Global Author Profile & Avatar Sync Everywhere -->
    <script is:inline>
      (function syncAuthorProfile() {
        const savedAvatar = localStorage.getItem('kherokhata_author_avatar');
        if (savedAvatar) {
          document.querySelectorAll('.author-avatar-img').forEach((img) => {
            img.src = savedAvatar;
          });
        }

        const customProfile = localStorage.getItem('kherokhata_author_custom');
        if (customProfile) {
          try {
            const data = JSON.parse(customProfile);
            if (data.name) {
              document.querySelectorAll('.author-name-text').forEach((el) => { el.textContent = data.name; });
            }
            if (data.education) {
              document.querySelectorAll('.author-edu-text').forEach((el) => { el.textContent = data.education; });
            }
            if (data.tagline) {
              document.querySelectorAll('.author-tagline-text').forEach((el) => { el.textContent = data.tagline; });
            }
            if (data.bio) {
              document.querySelectorAll('.author-shortbio-text').forEach((el) => { el.textContent = data.bio; });
            }
            if (data.bioFull) {
              document.querySelectorAll('.author-biofull-text').forEach((el) => { el.textContent = data.bioFull; });
            }
            if (data.avatar) {
              document.querySelectorAll('.author-avatar-img').forEach((img) => { img.src = data.avatar; });
            }
            if (data.facebook) {
              document.querySelectorAll('.author-facebook-link').forEach((a) => { a.href = data.facebook; });
            }
            if (data.whatsapp) {
              document.querySelectorAll('.author-whatsapp-link').forEach((a) => { a.href = data.whatsapp; });
            }
            if (data.manifestoTitle) {
              document.querySelectorAll('.author-manifesto-title-text').forEach((el) => { el.textContent = data.manifestoTitle; });
            }
            if (data.manifesto) {
              document.querySelectorAll('.author-manifesto-text').forEach((el) => { el.textContent = data.manifesto; });
            }
          } catch (e) {}
        }
      })();

      window.addEventListener('kherokhata-author-sync', () => {
        const customProfile = localStorage.getItem('kherokhata_author_custom');
        if (customProfile) {
          try {
            const data = JSON.parse(customProfile);
            if (data.name) document.querySelectorAll('.author-name-text').forEach((el) => { el.textContent = data.name; });
            if (data.education) document.querySelectorAll('.author-edu-text').forEach((el) => { el.textContent = data.education; });
            if (data.tagline) document.querySelectorAll('.author-tagline-text').forEach((el) => { el.textContent = data.tagline; });
            if (data.bio) document.querySelectorAll('.author-shortbio-text').forEach((el) => { el.textContent = data.bio; });
            if (data.bioFull) document.querySelectorAll('.author-biofull-text').forEach((el) => { el.textContent = data.bioFull; });
            if (data.avatar) document.querySelectorAll('.author-avatar-img').forEach((img) => { img.src = data.avatar; });
            if (data.facebook) document.querySelectorAll('.author-facebook-link').forEach((a) => { a.href = data.facebook; });
            if (data.whatsapp) document.querySelectorAll('.author-whatsapp-link').forEach((a) => { a.href = data.whatsapp; });
            if (data.manifestoTitle) document.querySelectorAll('.author-manifesto-title-text').forEach((el) => { el.textContent = data.manifestoTitle; });
            if (data.manifesto) document.querySelectorAll('.author-manifesto-text').forEach((el) => { el.textContent = data.manifesto; });
          } catch (e) {}
        }
      });
    </script>

    <!-- Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').then(
            (reg) => {
              console.log('[PWA] ServiceWorker registered successfully with scope:', reg.scope);
            },
            (err) => {
              console.warn('[PWA] ServiceWorker registration failed:', err);
            }
          );
        });
      }
    </script>
    <!-- Universal Author Admin Bar & Login Modal -->
    <AdminBarModal />
  </body>
</html>
