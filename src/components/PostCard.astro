---
// src/components/PostCard.astro
import type { CollectionEntry } from 'astro:content';
import { formatBengaliDate, calculateReadingTime, CATEGORY_MAP } from '../utils/helpers';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const catInfo = CATEGORY_MAP[post.data.category] || { label: post.data.category, slug: post.data.category };
const formattedDate = formatBengaliDate(post.data.publishedAt);
const readingTime = calculateReadingTime(post.body || '');
---

<article
  class="post-item group relative flex flex-col justify-between rounded-3xl border border-paper-border/90 dark:border-night-border/90 bg-paper-surface/85 dark:bg-night-surface/85 backdrop-blur-xl p-6 sm:p-7 shadow-xs hover:shadow-2xl hover:shadow-paper-accent/10 dark:hover:shadow-night-accent/15 md:hover:-translate-y-1.5 active:scale-[0.99] transition-all duration-300 overflow-hidden cursor-pointer"
  data-category={post.data.category}
  onclick={`if (!event.target.closest('a')) window.location.href='/${post.slug}';`}
>
  <!-- Ambient Liquid Glow on Hover -->
  <div class="absolute -right-20 -top-20 w-48 h-48 rounded-full bg-paper-accent/5 dark:bg-night-accent/10 blur-2xl group-hover:scale-150 group-hover:bg-paper-accent/12 dark:group-hover:bg-night-accent/20 transition-all duration-700 pointer-events-none"></div>

  <!-- Subtle Top Shimmer Border Beam -->
  <div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-paper-accent/30 dark:via-night-accent/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

  <div class="relative space-y-4">
    <!-- Meta Bar with Liquid Category Pill -->
    <div class="flex items-center justify-between text-xs font-sans text-paper-muted dark:text-night-muted">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full font-serif font-medium bg-paper-accent/10 dark:bg-night-accent/10 text-paper-accent dark:text-night-accent border border-paper-accent/20 dark:border-night-accent/20 shadow-2xs group-hover:scale-105 transition-transform duration-300">
        <span class="w-1.5 h-1.5 rounded-full bg-paper-accent dark:bg-night-accent animate-pulse"></span>
        {catInfo.label}
      </span>
      <div class="flex items-center gap-2 font-sans text-[11px] sm:text-xs">
        <time datetime={post.data.publishedAt} class="opacity-80">{formattedDate}</time>
        <span>·</span>
        <span class="opacity-80">{readingTime}</span>
      </div>
    </div>

    <!-- Title with Kalpurush Font & Smooth Accent Hover -->
    <h3 class="text-xl sm:text-2xl font-bold font-serif text-paper-text dark:text-night-text group-hover:text-paper-accent dark:group-hover:text-night-accent transition-colors duration-300 leading-snug">
      <a href={`/${post.slug}`} class="block hover:underline" data-astro-prefetch="hover">
        {post.data.title}
      </a>
    </h3>

    <!-- Excerpt with Literary Line Clamping -->
    <p class="text-sm sm:text-base text-paper-muted dark:text-night-muted font-serif leading-relaxed line-clamp-3">
      {post.data.description}
    </p>
  </div>

  <!-- Footer Tags & High-Tactile Read Button -->
  <div class="relative mt-6 pt-4 border-t border-paper-border/60 dark:border-night-border/60 flex items-center justify-between text-xs font-sans gap-3">
    <div class="flex flex-wrap gap-1.5 z-10 relative">
      {post.data.tags.slice(0, 2).map((tag) => (
        <span class="px-2.5 py-0.5 rounded-full bg-paper-border/50 dark:bg-night-border/50 text-paper-muted dark:text-night-muted text-[11px] font-sans">
          #{tag}
        </span>
      ))}
    </div>

    <!-- Explicit High-Contrast Touch Target (min 44px height for mobile ergonomics) -->
    <a
      href={`/${post.slug}`}
      class="inline-flex items-center gap-1.5 px-3.5 py-2 min-h-[44px] rounded-full bg-paper-accent/10 dark:bg-night-accent/15 text-paper-accent dark:text-night-accent font-semibold text-xs font-sans border border-paper-accent/25 dark:border-night-accent/30 hover:bg-paper-accent hover:text-white dark:hover:bg-night-accent dark:hover:text-stone-900 transition-all duration-200 cursor-pointer active:scale-95 shadow-2xs z-20"
      aria-label={`সম্পূর্ণ পড়ুন: ${post.data.title}`}
      data-astro-prefetch="hover"
    >
      <span class="font-sans font-medium">পড়ুন</span>
      <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
  </div>
</article>
