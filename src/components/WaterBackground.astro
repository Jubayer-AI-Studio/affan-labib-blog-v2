---
// src/components/WaterBackground.astro - Ultra-Lightweight Ambient Liquid Aura (Zero-CPU, Pure CSS)
---

<!-- Ambient Liquid Aura & Subtle Vignette (Pure GPU-accelerated CSS, 0% CPU, 0% JS) -->
<div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden select-none" aria-hidden="true">
  <!-- Soft Ambient Liquid Glow Orbs (Subtle, non-distracting literary atmosphere) -->
  <div class="ambient-orb ambient-orb-1 absolute -top-24 -left-24 w-80 sm:w-96 h-80 sm:h-96 rounded-full bg-gradient-to-br from-amber-500/10 via-orange-500/5 to-transparent dark:from-amber-400/5 dark:via-orange-500/5 blur-3xl opacity-60"></div>
  <div class="ambient-orb ambient-orb-2 absolute top-1/3 -right-24 w-80 sm:w-[28rem] h-80 sm:h-[28rem] rounded-full bg-gradient-to-bl from-teal-500/10 via-emerald-500/5 to-transparent dark:from-teal-400/5 dark:via-cyan-500/5 blur-3xl opacity-50"></div>
  <div class="ambient-orb ambient-orb-3 absolute -bottom-24 left-1/4 w-80 sm:w-96 h-80 sm:h-96 rounded-full bg-gradient-to-tr from-rose-500/8 via-amber-500/5 to-transparent dark:from-orange-500/5 dark:via-amber-400/5 blur-3xl opacity-50"></div>

  <!-- Subtle Radial Vignette Grid -->
  <div class="absolute inset-0 bg-radial-vignette opacity-40"></div>
</div>

<style>
  .ambient-orb {
    transform: translateZ(0);
    will-change: transform;
  }
  .bg-radial-vignette {
    background: radial-gradient(circle at 50% 20%, transparent 40%, rgba(0, 0, 0, 0.03) 100%);
  }
  :global(html.sepia) .bg-radial-vignette {
    background: radial-gradient(circle at 50% 20%, transparent 40%, rgba(140, 78, 26, 0.05) 100%);
  }
  :global(html.dark) .bg-radial-vignette {
    background: radial-gradient(circle at 50% 20%, transparent 40%, rgba(0, 0, 0, 0.25) 100%);
  }
</style>
