---
// BookInfoCard.astro
interface Props {
  bookTitle: string;
  author: string;
  publisher?: string;
  publishedYear?: string;
  pages?: string;
  ratingIndicator?: string;
  coverImage?: string;
  purchaseUrl?: string;
}

const {
  bookTitle,
  author,
  publisher,
  publishedYear,
  pages,
  ratingIndicator,
  coverImage,
  purchaseUrl,
} = Astro.props;
---

<div class="my-8 p-5 sm:p-6 rounded-lg bg-paper-surface dark:bg-night-surface border border-paper-border dark:border-night-border shadow-sm transition-colors not-prose">
  <div class="flex flex-col sm:flex-row gap-5 items-start">
    {coverImage && (
      <div class="w-24 sm:w-28 flex-shrink-0 mx-auto sm:mx-0">
        <img
          src={coverImage}
          alt={`প্রচ্ছদ: ${bookTitle}`}
          class="w-full h-auto rounded shadow border border-paper-border dark:border-night-border object-cover"
          loading="lazy"
        />
      </div>
    )}

    <div class="flex-grow w-full space-y-3 font-serif">
      <div class="flex flex-wrap items-start justify-between gap-2 border-b border-paper-border/60 dark:border-night-border/60 pb-3">
        <div>
          <span class="text-xs uppercase tracking-wider text-paper-accent dark:text-night-accent font-sans font-semibold">
            গ্রন্থ-তথ্য
          </span>
          <h3 class="text-xl sm:text-2xl font-bold text-paper-text dark:text-night-text mt-0.5">
            {bookTitle}
          </h3>
          <p class="text-sm text-paper-muted dark:text-night-muted mt-0.5">
            লেখক: <span class="font-medium text-paper-text dark:text-night-text">{author}</span>
          </p>
        </div>

        {ratingIndicator && (
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium font-sans bg-paper-accent/10 dark:bg-night-accent/10 text-paper-accent dark:text-night-accent border border-paper-accent/20 dark:border-night-accent/20">
            ★ {ratingIndicator}
          </span>
        )}
      </div>

      <!-- Book Metadata Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-sm pt-1">
        {publisher && (
          <div>
            <span class="text-xs text-paper-muted dark:text-night-muted block font-sans">প্রকাশনী</span>
            <span class="font-medium text-paper-text dark:text-night-text">{publisher}</span>
          </div>
        )}
        {publishedYear && (
          <div>
            <span class="text-xs text-paper-muted dark:text-night-muted block font-sans">প্রকাশকাল</span>
            <span class="font-medium text-paper-text dark:text-night-text">{publishedYear}</span>
          </div>
        )}
        {pages && (
          <div>
            <span class="text-xs text-paper-muted dark:text-night-muted block font-sans">পৃষ্ঠা সংখ্যা</span>
            <span class="font-medium text-paper-text dark:text-night-text">{pages}</span>
          </div>
        )}
      </div>

      {purchaseUrl && (
        <div class="pt-2">
          <a
            href={purchaseUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs font-sans text-paper-accent dark:text-night-accent hover:underline"
          >
            <span>বইটি সংগ্রহ করার লিংক</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      )}
    </div>
  </div>
</div>
