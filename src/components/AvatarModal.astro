---
// src/components/AvatarModal.astro
---

<!-- Photo Change Interactive Modal -->
<div
  id="avatar-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="avatar-modal-title"
>
  <div class="bg-paper-surface dark:bg-night-surface border border-paper-border dark:border-night-border rounded-2xl max-w-md w-full p-6 shadow-2xl relative">
    <!-- Close Button -->
    <button
      id="close-avatar-modal"
      type="button"
      class="absolute top-4 right-4 p-2 text-paper-muted dark:text-night-muted hover:text-paper-accent dark:hover:text-night-accent rounded-full transition-colors"
      aria-label="বন্ধ করুন"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="text-center mb-6">
      <div class="w-16 h-16 mx-auto mb-3 rounded-full overflow-hidden border-2 border-paper-accent dark:border-night-accent p-0.5 shadow-md">
        <img
          id="modal-avatar-preview"
          src="/images/affan-labib.jpg"
          alt="প্রিভিউ"
          class="w-full h-full object-cover rounded-full"
        />
      </div>
      <h2 id="avatar-modal-title" class="text-xl font-bold font-serif text-paper-text dark:text-night-text">
        প্রোফাইল ছবি পরিবর্তন করুন
      </h2>
      <p class="text-xs text-paper-muted dark:text-night-muted font-sans mt-1">
        আপনার মোবাইল বা পিসি থেকে আসল ছবি আপলোড করুন
      </p>
    </div>

    <!-- Upload Options -->
    <div class="space-y-4">
      <!-- Option 1: File Upload -->
      <div class="p-4 rounded-xl border border-paper-accent/30 dark:border-night-accent/30 bg-paper-accent/5 dark:bg-night-accent/5 text-center">
        <label
          for="avatar-file-input"
          class="cursor-pointer inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-paper-accent dark:bg-night-accent text-white font-sans text-sm font-medium hover:opacity-95 transition-opacity w-full shadow-xs"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          ডিভাইস থেকে ছবি বেছে নিন
        </label>
        <input
          id="avatar-file-input"
          type="file"
          accept="image/*"
          class="hidden"
        />
        <p class="text-[11px] text-paper-muted dark:text-night-muted mt-2 font-sans">
          JPG, PNG বা WebP ছবি নির্বাচন করুন (স্বয়ংক্রিয়ভাবে সেভ হবে)
        </p>
      </div>

      <!-- Option 2: Image URL -->
      <div class="space-y-2">
        <label for="avatar-url-input" class="block text-xs font-medium font-sans text-paper-text dark:text-night-text">
          অথবা ছবির অনলাইন লিংক (URL) দিন:
        </label>
        <div class="flex gap-2">
          <input
            id="avatar-url-input"
            type="url"
            placeholder="https://example.com/photo.jpg"
            class="flex-1 px-3 py-2 text-xs rounded-lg border border-paper-border dark:border-night-border bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text focus:outline-none focus:border-paper-accent"
          />
          <button
            id="apply-avatar-url"
            type="button"
            class="px-3 py-2 text-xs rounded-lg border border-paper-border dark:border-night-border hover:bg-paper-border/40 font-sans font-medium"
          >
            প্রয়োগ
          </button>
        </div>
      </div>

      <!-- Reset button -->
      <div class="pt-2 text-center">
        <button
          id="reset-avatar-btn"
          type="button"
          class="text-xs text-paper-muted dark:text-night-muted hover:text-red-600 transition-colors font-sans"
        >
          ডিফল্ট ছবিতে ফিরে যান
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  const avatarModal = document.getElementById('avatar-modal');
  const closeAvatarBtn = document.getElementById('close-avatar-modal');
  const fileInput = document.getElementById('avatar-file-input');
  const urlInput = document.getElementById('avatar-url-input');
  const applyUrlBtn = document.getElementById('apply-avatar-url');
  const resetBtn = document.getElementById('reset-avatar-btn');
  const previewImg = document.getElementById('modal-avatar-preview');

  // Load saved avatar on page boot
  function applyGlobalAvatar(src) {
    if (!src) return;
    document.querySelectorAll('.author-avatar-img').forEach((img) => {
      img.src = src;
    });
    if (previewImg) previewImg.src = src;
  }

  // Check localStorage on load
  const savedAvatar = localStorage.getItem('kherokhata_author_avatar');
  if (savedAvatar) {
    applyGlobalAvatar(savedAvatar);
  }

  window.openAvatarModal = () => {
    avatarModal?.classList.remove('hidden');
  };

  closeAvatarBtn?.addEventListener('click', () => {
    avatarModal?.classList.add('hidden');
  });

  avatarModal?.addEventListener('click', (e) => {
    if (e.target === avatarModal) avatarModal.classList.add('hidden');
  });

  // Handle File Upload
  fileInput?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      const base64 = event.target?.result;
      if (typeof base64 === 'string') {
        localStorage.setItem('kherokhata_author_avatar', base64);
        applyGlobalAvatar(base64);
        avatarModal?.classList.add('hidden');
      }
    };
    reader.readAsDataURL(file);
  });

  // Handle URL input
  applyUrlBtn?.addEventListener('click', () => {
    const url = urlInput?.value.trim();
    if (url) {
      localStorage.setItem('kherokhata_author_avatar', url);
      applyGlobalAvatar(url);
      avatarModal?.classList.add('hidden');
    }
  });

  // Reset
  resetBtn?.addEventListener('click', () => {
    localStorage.removeItem('kherokhata_author_avatar');
    applyGlobalAvatar('/images/affan-labib.jpg');
    avatarModal?.classList.add('hidden');
  });
</script>
