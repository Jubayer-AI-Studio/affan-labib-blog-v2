---
// src/components/AuthorHero.astro
import author from '../data/author.json';
import AvatarModal from './AvatarModal.astro';
---

<div class="relative overflow-hidden rounded-3xl border border-paper-border/90 dark:border-night-border/90 bg-paper-surface/85 dark:bg-night-surface/85 backdrop-blur-2xl p-6 sm:p-9 shadow-md hover:shadow-xl transition-all duration-400 mb-12 group">
  <!-- Dynamic Liquid Aura in Background -->
  <div class="absolute -right-20 -top-20 w-64 h-64 rounded-full bg-gradient-to-br from-paper-accent/10 via-amber-500/10 to-transparent blur-3xl group-hover:scale-125 transition-transform duration-700 pointer-events-none"></div>

  <!-- Top Glass Highlight Beam -->
  <div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-paper-accent/40 dark:via-night-accent/40 to-transparent"></div>

  <div class="relative flex flex-col md:flex-row items-center md:items-start gap-6 sm:gap-8">
    <!-- Avatar Section with Interactive Change Photo Button & Ripple Aura -->
    <div class="relative group/avatar flex-shrink-0 text-center">
      <div class="relative w-24 h-24 sm:w-28 sm:h-28 rounded-2xl overflow-hidden ring-4 ring-paper-accent/20 dark:ring-night-accent/30 shadow-lg transition-transform duration-300 group-hover/avatar:scale-105">
        <img
          src={author.avatar}
          alt={author.name}
          class="author-avatar-img w-full h-full object-cover"
        />
        <!-- Liquid Reflection Overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-white/10 pointer-events-none"></div>
      </div>

      <!-- Change photo camera button overlay -->
      <button
        type="button"
        onclick="window.openAvatarModal && window.openAvatarModal()"
        class="absolute -bottom-2 -right-2 p-2 rounded-xl bg-gradient-to-br from-paper-accent to-orange-700 dark:from-night-accent dark:to-orange-600 text-white shadow-lg hover:scale-115 active:scale-95 transition-transform cursor-pointer border border-white/20"
        title="প্রোফাইল ছবি পরিবর্তন করুন"
        aria-label="Change Profile Photo"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </button>
    </div>

    <!-- Author Details & Bio -->
    <div class="flex-grow space-y-3.5 text-center md:text-left">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div>
          <div class="flex items-center justify-center md:justify-start gap-2.5">
            <h1 class="author-name-text text-2xl sm:text-3xl font-bold font-serif text-paper-text dark:text-night-text tracking-tight">
              {author.name}
            </h1>
            <!-- Verified author checkmark -->
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-paper-accent/15 dark:bg-night-accent/20 text-paper-accent dark:text-night-accent text-xs font-bold ring-1 ring-paper-accent/30" title="লেখক ও গবেষক">
              ✓
            </span>
          </div>
          <p class="author-edu-text text-sm font-sans text-paper-accent dark:text-night-accent font-medium mt-0.5">
            {author.education} · {author.tagline}
          </p>
        </div>

        <!-- Quick Action Buttons -->
        <div class="flex items-center justify-center md:justify-end gap-2.5 pt-2 md:pt-0 flex-wrap">
          <a
            href={author.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="author-facebook-link inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-[#1877F2] text-white font-sans text-xs font-semibold hover:bg-[#166fe5] shadow-xs hover:shadow-md hover:scale-105 active:scale-95 transition-all"
            title="আফফান লাবীবের অফিসিয়াল ফেসবুক প্রোফাইল"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>ফেসবুকে যুক্ত হন</span>
          </a>

          <a
            href={author.social.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="author-whatsapp-link inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-[#25D366] text-white font-sans text-xs font-semibold hover:bg-[#20ba59] shadow-xs hover:shadow-md hover:scale-105 active:scale-95 transition-all"
            title="হোয়াটসঅ্যাপে সরাসরি মেসেজ দিন (01577118153)"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>হোয়াটসঅ্যাপ</span>
          </a>

          <button
            type="button"
            onclick="window.openAvatarModal && window.openAvatarModal()"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-paper-accent/30 dark:border-night-accent/30 text-paper-accent dark:text-night-accent hover:bg-paper-accent/10 font-sans text-xs font-semibold transition-all cursor-pointer hover:scale-102"
            title="ছবি বদলান"
          >
            <span>📷</span>
            <span>ছবি বদলান</span>
          </button>
        </div>
      </div>

      <p class="author-shortbio-text text-base sm:text-lg text-paper-muted dark:text-night-muted leading-relaxed font-serif">
        {author.bioShort}
      </p>

      <!-- Stats Bar & About Link -->
      <div class="pt-3 flex flex-wrap items-center justify-center md:justify-between gap-3 text-xs font-sans text-paper-muted dark:text-night-muted border-t border-paper-border/60 dark:border-night-border/60">
        <div class="flex items-center gap-3">
          <span class="flex items-center gap-1">📚 ১০টি প্রকাশিত লেখা</span>
          <span>·</span>
          <span class="flex items-center gap-1">🏷️ ৫টি বিষয়শ্রেণী</span>
          <span>·</span>
          <span class="text-emerald-700 dark:text-emerald-400 font-medium flex items-center gap-1">⚡ অফলাইন সক্রিয়</span>
        </div>
        <a href="/about" class="text-paper-accent dark:text-night-accent hover:underline font-serif font-medium flex items-center gap-1">
          <span>আমার সম্পর্কে আরও জানুন</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>
</div>

<AvatarModal />
