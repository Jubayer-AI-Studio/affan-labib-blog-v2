---
// Header.astro
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';
import InstallModal from './InstallModal.astro';
import LiveClock from './LiveClock.astro';

const navLinks = [
  { href: '/category/chinta', label: 'চিন্তা', key: 'nav_chinta' },
  { href: '/category/pathalap', label: 'পাঠালাপ', key: 'nav_pathalap' },
  { href: '/category/itihas', label: 'ইতিহাস', key: 'nav_itihas' },
  { href: '/category/boi-alochona', label: 'বই-আলোচনা', key: 'nav_boi' },
  { href: '/bookshelf', label: 'বুকশেলফ', key: 'nav_bookshelf' },
  { href: '/about', label: 'আমার সম্পর্কে', key: 'nav_about' },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-paper-border/80 dark:border-night-border/80 bg-paper-bg/80 dark:bg-night-bg/80 backdrop-blur-xl sticky top-0 z-40 transition-colors shadow-2xs">
  <!-- Ultra-Luxe Live Date & Ticking Seconds Chronometer -->
  <LiveClock />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-3.5 sm:py-4 flex items-center justify-between">
    <!-- Brand / Title -->
    <div>
      <a href="/" class="group block">
        <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-paper-text dark:text-night-text group-hover:text-paper-accent dark:group-hover:text-night-accent transition-colors font-serif">
          আফফান লাবীব
        </h1>
        <p class="text-xs text-paper-muted dark:text-night-muted font-sans tracking-wide mt-0.5" data-i18n="tagline">
          চিন্তা ও পাঠের নিভৃত আঙিনা
        </p>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-1 lg:space-x-2.5 text-sm font-medium">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class:list={[
              'px-2.5 py-1.5 rounded-md transition-colors',
              isActive
                ? 'text-paper-accent dark:text-night-accent font-semibold bg-paper-accent/10 dark:bg-night-accent/10'
                : 'text-paper-muted dark:text-night-muted hover:text-paper-text dark:hover:text-night-text hover:bg-paper-border/40 dark:hover:bg-night-border/40'
            ]}
          >
            <span data-i18n={link.key}>{link.label}</span>
          </a>
        );
      })}

      <!-- Search Icon Link -->
      <a
        href="/search"
        class="p-2 rounded-full text-paper-muted dark:text-night-muted hover:text-paper-accent dark:hover:text-night-accent hover:bg-paper-border/40 dark:hover:bg-night-border/50 transition-colors"
        title="অনুসন্ধান করুন"
        aria-label="Search"
        data-i18n-title="search"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </a>

      <!-- Install App Button (Minimalist) -->
      <button
        type="button"
        onclick="window.openInstallModal && window.openInstallModal()"
        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs rounded-md font-sans font-medium text-paper-accent dark:text-night-accent hover:bg-paper-accent/10 dark:hover:bg-night-accent/10 border border-paper-accent/30 dark:border-night-accent/30 transition-colors cursor-pointer"
        title="মোবাইল বা পিসিতে অ্যাপ ইনস্টল করুন"
      >
        <span>📲</span>
        <span data-i18n="install">অ্যাপ নামান</span>
      </button>

      <!-- Author Studio Quick Entrance -->
      <button
        type="button"
        onclick="window.openAdminStudio && window.openAdminStudio()"
        class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs rounded-full font-sans font-medium text-paper-muted dark:text-night-muted hover:text-paper-accent dark:hover:text-night-accent hover:bg-paper-border/40 dark:hover:bg-night-border/40 border border-paper-border/60 dark:border-night-border/60 transition-colors cursor-pointer"
        title="আফফান লাবীব — লেখক স্টুডিও প্রবেশদ্বার (পাসওয়ার্ড সুরক্ষিত)"
      >
        <span>🔐</span>
        <span class="hidden lg:inline" data-i18n="studio">লেখক স্টুডিও</span>
      </button>

      <!-- Theme Mode Toggle -->
      <ThemeToggle />

      <!-- Language Toggle -->
      <LanguageToggle />
    </nav>

    <!-- Mobile Action Buttons -->
    <div class="flex items-center space-x-1 sm:space-x-1.5 md:hidden">
      <!-- Mobile Quick Studio Lock -->
      <button
        type="button"
        onclick="window.openAdminStudio && window.openAdminStudio()"
        class="p-1.5 rounded-full text-paper-muted dark:text-night-muted hover:text-paper-accent"
        title="লেখক স্টুডিও"
        aria-label="Author Studio"
      >
        🔐
      </button>
      <a
        href="/search"
        class="p-1.5 rounded-full text-paper-muted dark:text-night-muted hover:text-paper-accent"
        aria-label="Search"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </a>

      <!-- Mobile Theme Toggle -->
      <ThemeToggle />

      <!-- Mobile Language Toggle -->
      <LanguageToggle />

      <button
        id="mobile-menu-btn"
        type="button"
        class="p-1.5 rounded-md text-paper-muted dark:text-night-muted hover:text-paper-accent"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-paper-border/60 dark:border-night-border/60 px-4 pt-2 pb-4 bg-paper-bg dark:bg-night-bg space-y-1">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href;
      return (
        <a
          href={link.href}
          class:list={[
            'block px-3 py-2 rounded-md text-base font-serif',
            isActive
              ? 'text-paper-accent dark:text-night-accent font-semibold bg-paper-accent/10 dark:bg-night-accent/10'
              : 'text-paper-text dark:text-night-text hover:bg-paper-border/30 dark:hover:bg-night-border/30'
          ]}
        >
          <span data-i18n={link.key}>{link.label}</span>
        </a>
      );
    })}

    <!-- Mobile Install Button -->
    <button
      type="button"
      onclick="window.openInstallModal && window.openInstallModal(); document.getElementById('mobile-menu')?.classList.add('hidden');"
      class="w-full text-left flex items-center justify-between px-3 py-2.5 rounded-md text-base font-serif text-paper-accent dark:text-night-accent hover:bg-paper-border/30 dark:hover:bg-night-border/30 border border-paper-accent/30 dark:border-night-accent/30 mt-2 bg-paper-accent/5 dark:bg-night-accent/5 cursor-pointer"
    >
      <span class="flex items-center gap-2">
        <span data-i18n="install_full">📲 অ্যাপ নামান / ইনস্টল</span>
      </span>
      <span class="text-xs font-sans px-2 py-0.5 rounded-full bg-paper-accent/15 text-paper-accent dark:text-night-accent font-medium" data-i18n="install_badge">
        অফলাইন রিডিং
      </span>
    </button>

    <!-- Mobile Author Studio Button -->
    <button
      type="button"
      onclick="window.openAdminStudio && window.openAdminStudio(); document.getElementById('mobile-menu')?.classList.add('hidden');"
      class="w-full text-left flex items-center justify-between px-3 py-2.5 rounded-md text-base font-serif text-paper-text dark:text-night-text hover:bg-paper-border/30 border border-paper-border/60 dark:border-night-border/60 mt-2 cursor-pointer bg-paper-surface/40"
    >
      <span class="flex items-center gap-2">
        <span data-i18n="studio_full">🔐 লেখক স্টুডিও (অ্যাডমিন)</span>
      </span>
      <span class="text-xs font-sans text-paper-muted" data-i18n="studio_badge">
        পাসওয়ার্ড কোড
      </span>
    </button>
  </div>

  <!-- Global Install Options Modal -->
  <InstallModal />
</header>

<script is:inline>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>

